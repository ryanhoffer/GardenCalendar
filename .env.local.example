# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase → Project Settings → API.
# .env.local is gitignored; NEVER commit real keys.
#
# Also add both variables in Vercel → Project → Settings → Environment
# Variables (Production, Preview, and Development scopes).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Admin panel (server-only) — required by /api/admin/* endpoints.
# The service-role key bypasses RLS; NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe billing (see BILLING.md) ----
# Secret keys are server-only; the publishable key + price IDs are safe to expose.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_TRIAL_DAYS=14
# Base URL used for Stripe success/cancel/return redirects (no trailing slash).
APP_URL=https://your-domain.com

